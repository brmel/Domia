{
  "name": "domia",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:runtime-cutover": "node scripts/check-runtime-cutover.mjs",
    "check:kpi-slo": "node scripts/check-kpi-slo.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cli": "tsx tests/cli/run-cli-tests.ts",
    "test:all": "tsx tests/run-all-tests.ts",
    "readiness:gate": "node scripts/readiness-gate.mjs",
    "release:check": "node scripts/readiness-gate.mjs --profile=production",
    "cli": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs src/cli/index.ts",
    "package": "npm run build && electron-builder",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.21.0",
