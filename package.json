{
  "name": "domia",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:code-markers": "node scripts/check-code-markers.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cli": "tsx tests/cli/run-cli-tests.ts",
    "test:all": "tsx tests/run-all-tests.ts",
    "readiness:gate": "node scripts/readiness-gate.mjs",
    "release:check": "node scripts/readiness-gate.mjs --profile=production",
    "cli": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs src/cli/index.ts",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@google/adk": "^0.3.0",
    "@tanstack/react-query": "^5.90.20",
    "@trpc/client": "^11.9.0",
    "@trpc/react-query": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "async-lock": "^1.4.1",
    "chalk": "^5.6.2",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.0",
    "debug": "^4.4.3",
    "figlet": "^1.10.0",
    "fs-extra": "^11.3.3",
    "inquirer": "^13.2.2",
    "junit-report-builder": "^5.1.1",
    "kysely": "^0.28.11",
    "kysely-wasm": "^1.2.1",
    "nanoid": "^5.0.0",
    "neverthrow": "^7.0.0",
    "ora": "^9.3.0",
    "playwright": "^1.45.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-json-view": "^1.21.3",
    "reflect-metadata": "^0.2.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.4.0",
    "trpc-electron": "^0.1.2",
    "tsyringe": "^4.8.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/async-lock": "^1.4.2",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.2.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.0.0"
