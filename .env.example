# Domia environment. Copy this file to `.env` and fill in the values.
# `npm run setup` (or setup/setup.sh / setup/setup.cmd) creates `.env` from this template.

# Required — Google Gemini API key that drives the agent.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional — override the default model (default: gemini-2.0-flash).
# DOMIA_MODEL=gemini-2.0-flash

# Optional — HTTP port for the read-only server (`npm run server`), default 4317.
# DOMIA_SERVER_PORT=4317
