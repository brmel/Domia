# Domia environment. Copy this file to `.env` and fill in the values.
# `npm run setup` (or setup/setup.sh / setup/setup.cmd) creates `.env` from this template.

# Gemini auth — pick ONE of the two modes below.
#
# Mode 1 (simplest): API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Mode 2 (enterprise / Vertex AI): GCP service account via Application Default
# Credentials. Either save the JSON as ~/.domia/gcp-credentials.json (picked up
# automatically, nothing to set here), or point at it explicitly:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Project comes from the JSON's project_id; override region/project if needed:
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1
# Force a mode instead of auto-detection (api_key wins when both exist):
# DOMIA_LLM_AUTH_MODE=api_key|adc

# Optional — API key override that beats config + GOOGLE_API_KEY for a run.
# DOMIA_LLM_API_KEY=

# Optional — read-only HTTP server (`npm run server`): port + bind host.
# Defaults: 4317, 127.0.0.1. Set host to 0.0.0.0 only if you want LAN access.
# DOMIA_SERVER_PORT=4317
# DOMIA_SERVER_HOST=127.0.0.1
