# Domia environment. Copy this file to `.env` and fill in the values.
# `npm run setup` (or setup/setup.sh / setup/setup.cmd) creates `.env` from this template.

# Required — Google Gemini API key that drives the agent.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional — API key override that beats config + GOOGLE_API_KEY for a run.
# DOMIA_LLM_API_KEY=

# Optional — read-only HTTP server (`npm run server`): port + bind host.
# Defaults: 4317, 127.0.0.1. Set host to 0.0.0.0 only if you want LAN access.
# DOMIA_SERVER_PORT=4317
# DOMIA_SERVER_HOST=127.0.0.1
