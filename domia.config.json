{
  "headless": true,
  "viewMode": "embedded",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "limits": {
    "maxSteps": 20
  },
  "ai": {
    "provider": "google",
    "model": "gemini-2.5-flash",
    "visionEnabled": true,
    "debugScreenshots": true
  },
  "paths": {
    "artifactsDir": "./artifacts",
    "databasePath": "./domia.db"
  },
  "plugins": {
    "shell": {
      "enabled": false
    }
  },
  "reporting": {
    "defaultFormat": "none",
    "outputDir": "./reports"
  }
}
