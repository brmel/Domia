{
  "headless": true,
  "viewport": {
    "width": 1280,
    "height": 800
  },
  "ai": {
    "provider": "google",
    "model": "gemini-2.0-flash",
    "visionEnabled": true,
    "debugScreenshots": true
  },
  "selectorEngine": {
    "strategyOrder": [
      "fast",
      "semantic",
      "visual",
      "heuristic"
    ]
  },
  "paths": {
    "artifactsDir": "./artifacts",
    "databasePath": "./domia.db"
  },
  "limits": {
    "maxSteps": 20,
    "delayBetweenSteps": 1000
  }
}
