{
  "headless": true,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "ai": {
    "provider": "google",
    "model": "gemini-2.0-flash",
    "visionEnabled": false,
    "debugScreenshots": false
  },
  "paths": {
    "artifactsDir": "./artifacts",
    "databasePath": "./domia.db"
  },
  "limits": {
    "maxSteps": 20,
    "delayBetweenSteps": 1000,
    "maxReplansPerRun": 2
  },
  "plugins": {
    "shell": {
      "enabled": true
    }
  },
  "reporting": {
    "defaultFormat": "none",
    "outputDir": "./reports"
  }
}
