{
  "name": "@domia/hosts-desktop",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "electron-vite dev",
